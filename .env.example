# The UI preview works without infrastructure; readiness requires both services.
# Copy this file to .env.local. Never prefix these variables with NEXT_PUBLIC_.

# Prisma PostgreSQL. For the local Prisma server, use its direct postgres:// URL.
# Hosted databases: use the host's pooled URL and recommended TLS settings.
DATABASE_URL=

# Explicit opt-in for synthetic sample data. Never enable on production databases.
ALLOW_DEVELOPMENT_SEED=false
# Home source: database (provider-synchronized records) or explicit demo preview.
# Demo also requires ALLOW_DEVELOPMENT_SEED=true. Tests configure this separately.
FOOTBALL_READ_MODE=database

# Choose ONE Redis transport. TCP supports local Redis and managed Redis TLS.
# Example local URL: redis://127.0.0.1:6379
# Start the configured development runtime with: npm run redis:local
REDIS_URL=

# Alternative: managed Redis REST. Both values must be configured together.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protected admin area. Use a long password and keep both values server-only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Scheduled synchronization and canonical metadata.
CRON_SECRET=
SITE_URL=http://localhost:3000
PASSWORD_RESET_MAILER_URL=http://localhost/futbl/api/send-reset-email.php
PASSWORD_RESET_MAILER_SECRET=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Touchline
# Set true only when a trusted reverse proxy sanitizes forwarding headers.
TRUST_PROXY=false

# External monitoring. Keep the webhook secret in the deployment environment.
HEALTHCHECK_URL=https://example.com/api/health/ready
HEALTH_ALERT_WEBHOOK_URL=
# Dedicated empty database used only by scheduled restore verification.
BACKUP_RESTORE_DATABASE_URL=
# Optional HTTPS error tracking sink. Payloads contain sanitized error metadata only.
ERROR_TRACKING_WEBHOOK_URL=

# API-Football provider (server-only). Optional comma-separated league IDs limit sync scope.
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUES=
# Free API-Football plans generally support seasons 2022-2024. Paid plans can use newer seasons.
API_FOOTBALL_SEASONS=2022,2023,2024
FOOTBALL_PROVIDER=football-data-org
# Match/results source and statistics source can be selected independently.
FOOTBALL_STATS_PROVIDER=sportmonks
FOOTBALL_DATA_TOKEN=
# Comma-separated football-data.org codes, for example:
# PL,BL1,SA,PD,FL1,CL
FOOTBALL_DATA_COMPETITIONS=PL

# SportMonks provider (server-only). Set FOOTBALL_PROVIDER=sportmonks to use it.
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
# Optional comma-separated SportMonks league IDs. Leave blank to sync all leagues
# available to the token. Example: 2,5,8,72,82,301,384,462,564,271
SPORTMONKS_LEAGUES=
SPORTMONKS_SEASONS=2023,2024,2025,2026
SPORTMONKS_LINEUP_MATCH_LIMIT=25

# GNews football headlines (server only)
GNEWS_API_KEY=
